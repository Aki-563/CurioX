{
  "name": "curiox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node scripts/brand-assets.mjs && astro dev --host 127.0.0.1",
    "brand": "node scripts/brand-assets.mjs",
    "check": "astro check",
    "build": "node scripts/build.mjs",
    "build:review": "node scripts/build-review.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "preview:review": "astro preview --host 127.0.0.1 --outDir dist-review",
    "preview:secure": "node scripts/serve-release.mjs",
    "audit:static": "node scripts/static-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:contrast": "node scripts/contrast.mjs",
    "test:perf": "node scripts/performance.mjs"
  },
  "dependencies": {
    "astro": "7.4.11",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.65.0",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
