---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../config/seo';
import { site } from '../config/site';
import Icon from '../components/ui/Icon.astro';
import '../styles/pages.css';
---

<BaseLayout {...seo.contact}>
  <section class="container simple-page" aria-labelledby="contact-heading">
    <h1 id="contact-heading">
      Contact<span class="accent">.</span>
    </h1>
    <p class="page-lead">Have a question or an idea? Email us.</p>
    <a tabindex="0" class="contact-email" href={'mailto:' + site.contact.email}>
      <span>{site.contact.email}</span>
      <Icon kind="diagonal" />
    </a>
    <p class="contact-note muted">Opens your email app.</p>
  </section>
</BaseLayout>
