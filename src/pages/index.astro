---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../config/seo';
import { site } from '../config/site';
import { products } from '../config/products';
import ButtonLink from '../components/ui/ButtonLink.astro';
import ProductCard from '../components/sections/ProductCard.astro';
import '../styles/products.css';
import '../styles/home.css';
---

<BaseLayout {...seo.home}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-layout">
      <h1 id="hero-heading" data-tagline-status={site.tagline.status}>
        Curious Minds.
        <br />
        <span class="accent">Creating Tomorrow.</span>
      </h1>
      <p class="hero-description">
        We're CURIOX. We explore new technology and build useful software.
      </p>
      <ButtonLink href="#products">View products</ButtonLink>
    </div>
  </section>
  <section
    class="container home-products"
    id="products"
    aria-labelledby="products-heading"
    data-reveal-group
  >
    <div class="home-section-heading" data-reveal>
      <h2 id="products-heading">Our products</h2>
      <a tabindex="0" class="section-link" href="/products/">
        All products <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="products-grid">
      {products.map((product) => (
        <ProductCard {product} headingLevel={3} />
      ))}
    </div>
  </section>
  <section class="home-contact rule" aria-labelledby="contact-heading">
    <div class="container home-contact-inner">
      <div>
        <h2 id="contact-heading">Get in touch</h2>
        <p class="muted">Have a question or an idea? Email us.</p>
      </div>
      <a
        tabindex="0"
        class="section-link"
        href={'mailto:' + site.contact.email}
      >
        {site.contact.email}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
