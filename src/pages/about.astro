---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../config/seo';
import ButtonLink from '../components/ui/ButtonLink.astro';
import '../styles/pages.css';
---

<BaseLayout {...seo.about}>
  <section class="container simple-page" aria-labelledby="about-heading">
    <h1 id="about-heading">
      About CurioX<span class="accent">.</span>
    </h1>
    <p class="page-lead">
      We explore new technology and build useful software.
    </p>
    <div class="about-details" data-reveal-group>
      <div id="purpose" data-reveal>
        <h2>Our goal</h2>
        <p class="muted">Make software easy to use and affordable.</p>
      </div>
      <div data-reveal>
        <h2>Who we build for</h2>
        <p class="muted">
          Students, developers, everyday users and small businesses.
        </p>
      </div>
    </div>
    <ButtonLink href="/products/">View products</ButtonLink>
  </section>
</BaseLayout>
