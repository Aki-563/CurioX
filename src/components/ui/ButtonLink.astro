---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  external?: boolean;
  download?: string | boolean;
}
const {
  href,
  variant = 'primary',
  external = false,
  download,
} = Astro.props;
---

<a
  tabindex="0"
  class:list={['button', `button--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download}
>
  <span>
    <slot />
    {external && <span class="sr-only"> (opens in a new tab)</span>}
  </span>
  <Icon kind={download ? 'download' : external ? 'diagonal' : 'arrow'} />
</a>
