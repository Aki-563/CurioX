---
import TextWordmark from '../ui/TextWordmark.astro';
import { navigation } from '../../config/navigation';
import { products } from '../../config/products';
import '../../styles/navigation.css';
---

<header class="site-header" data-header data-lenis-prevent>
  <div class="container header-inner">
    <TextWordmark />
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      hidden
    >
      <span class="sr-only" data-menu-label>
        Menu
      </span>
      <span class="menu-symbol" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>
    <nav id="main-navigation" class="main-navigation" aria-label="Main">
      {navigation
        .filter(({ href }) => href !== '/')
        .map(({ href, label }) =>
          href === '/products/' ? (
            <details class="products-disclosure">
              <summary
                tabindex="0"
                aria-current={Astro.url.pathname === href ? 'page' : undefined}
              >
                Products <span class="nav-chevron" aria-hidden="true"></span>
              </summary>
              <div class="products-dropdown">
                <div class="container products-dropdown-inner">
                  <div class="products-list">
                    {products.map((product) => (
                      <a
                        tabindex="0"
                        class="dropdown-product"
                        href={
                          product.href ??
                          `/products/#${product.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
                        }
                      >
                        {product.logo && (
                          <img
                            class="product-nav-icon"
                            src={product.logo}
                            alt=""
                            width="24"
                            height="24"
                          />
                        )}
                        <span class="product-nav-name">{product.name}</span>
                      </a>
                    ))}
                  </div>
                  <a tabindex="0" class="products-overview" href="/products/">
                    All products
                  </a>
                </div>
              </div>
            </details>
          ) : (
            <a
              tabindex="0"
              href={href}
              aria-current={Astro.url.pathname === href ? 'page' : undefined}
            >
              {label}
            </a>
          ),
        )}
    </nav>
  </div>
</header>
<script>
  import '../../scripts/navigation';
</script>
